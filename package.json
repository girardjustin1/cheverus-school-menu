{
  "name": "cheverus-school-menu",
  "version": "1.0.0",
  "description": "Cheverus School meals and Extended Day planning",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:netlify": "npm run build && npm run build-storybook -- --output-dir dist/storybook",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:test": "vitest run tests/database.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/girardjustin1/cheverus-school-menu.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/girardjustin1/cheverus-school-menu/issues"
  },
  "homepage": "https://github.com/girardjustin1/cheverus-school-menu#readme",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.2",
    "@netlify/identity": "^2.0.0",
    "@tanstack/react-query": "5.104.1",
    "date-fns": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router-dom": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
